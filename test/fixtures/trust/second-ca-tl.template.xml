    <TSLSequenceNumber>1</TSLSequenceNumber>
    <TSLType>http://uri.etsi.org/TrstSvc/TrustedList/TSLType/EUgeneric</TSLType>
    <SchemeOperatorName>
      <Name xml:lang="en">LibreSCRS Test Authority</Name>
    </SchemeOperatorName>
    <SchemeName>
      <Name xml:lang="en">LibreSCRS Test TL</Name>
    </SchemeName>
    <SchemeTerritory>RS</SchemeTerritory>
    <ListIssueDateTime>2026-04-28T00:00:00Z</ListIssueDateTime>
