From 7b50f5b86de1447b01b129849e8b86d9777f4904 Mon Sep 17 00:00:00 2001
From: hirashix0 <hirashix0@proton.me>
Date: Fri, 22 May 2026 09:22:59 +0200
Subject: [PATCH] ctx: scoped_reader_name field + apdu trace point

Adds:
1. sc_context_param_t::scoped_reader_name (exact-match per-context
   reader whitelist), with OPENSC_SCOPED_READER env var fallback.
   Filter hook in _sc_add_reader next to existing ignored_reader.
2. LIBRESCRS_PCSC_TRACE-gated trace point in sc_transmit_apdu for
   downstream cross-validation tooling. Zero runtime cost when env
   unset.
3. Doc update in etc/opensc.conf.example.in.

Use case: process loads opensc-pkcs11.so while holding an
authenticated card session on a different reader. Default
behaviour (NULL field, env unset) is unchanged.
---
 etc/opensc.conf.example.in | 11 +++++++++++
 src/libopensc/apdu.c       | 20 ++++++++++++++++++++
 src/libopensc/ctx.c        | 33 ++++++++++++++++++++++++++++++++-
 src/libopensc/internal.h   |  7 +++++++
 src/libopensc/opensc.h     | 12 ++++++++++++
 5 files changed, 82 insertions(+), 1 deletion(-)

diff --git a/etc/opensc.conf.example.in b/etc/opensc.conf.example.in
index 3781f48a3..34733554d 100644
--- a/etc/opensc.conf.example.in
+++ b/etc/opensc.conf.example.in
@@ -46,6 +46,17 @@ app default {
 	# Default: empty
 	# ignored_readers = "CardMan 1021", "SPR 532";
 
+	# Alternative to ignored_readers: a per-context exact-match
+	# whitelist. There is no opensc.conf knob (this is per-call
+	# only); set the OPENSC_SCOPED_READER environment variable to a
+	# reader name. When set, the libopensc context will only enrol
+	# the reader whose name matches exactly. Useful when an app loads
+	# opensc-pkcs11.so but already holds an authenticated session on
+	# another reader and wants to keep the other reader's card
+	# untouched.
+	#
+	# C API equivalent: sc_context_param_t::scoped_reader_name.
+
 	# CT-API module configuration.
 	reader_driver ctapi {
 		# module @LIBDIR@@LIB_PRE@towitoko@DYN_LIB_EXT@ {
diff --git a/src/libopensc/apdu.c b/src/libopensc/apdu.c
index 51b3aaac1..397e66aa3 100644
--- a/src/libopensc/apdu.c
+++ b/src/libopensc/apdu.c
@@ -547,6 +547,26 @@ int sc_transmit_apdu(sc_card_t *card, sc_apdu_t *apdu)
 	if (card == NULL || apdu == NULL)
 		return SC_ERROR_INVALID_ARGUMENTS;
 
+	/* Downstream env-gated APDU trace for cross-validation tooling.
+	 * Logs reader name + APDU header to stderr when LIBRESCRS_PCSC_TRACE
+	 * is set in the environment. Side-effect-free when the variable is
+	 * unset (cached comparison on the hot path). */
+	{
+		static int trace_enabled = -1;
+		if (trace_enabled == -1) {
+			const char *e = getenv("LIBRESCRS_PCSC_TRACE");
+			trace_enabled = (e && e[0] != '\0' && strcmp(e, "0") != 0) ? 1 : 0;
+		}
+		if (trace_enabled) {
+			fprintf(stderr,
+				"[PCSC_TRACE_LIBOPENSC] reader=%s cla=%02X ins=%02X p1=%02X p2=%02X lc=%zu le=%zu\n",
+				(card->reader && card->reader->name) ? card->reader->name : "(null)",
+				(unsigned)apdu->cla, (unsigned)apdu->ins,
+				(unsigned)apdu->p1, (unsigned)apdu->p2,
+				apdu->lc, apdu->le);
+		}
+	}
+
 	LOG_FUNC_CALLED(card->ctx);
 
 	/* determine the APDU type if necessary, i.e. to use
diff --git a/src/libopensc/ctx.c b/src/libopensc/ctx.c
index cbcbdcee9..458cdd167 100644
--- a/src/libopensc/ctx.c
+++ b/src/libopensc/ctx.c
@@ -72,9 +72,20 @@ static int ignored_reader(sc_context_t *ctx, sc_reader_t *reader)
 	return 0;
 }
 
+int scoped_out_reader(sc_context_t *ctx, sc_reader_t *reader)
+{
+	if (ctx == NULL || reader == NULL || ctx->scoped_reader_name == NULL)
+		return 0;
+	if (reader->name == NULL)
+		return 1;  /* unnamed readers cannot match an exact-name scope */
+	return strcmp(reader->name, ctx->scoped_reader_name) != 0;
+}
+
 int _sc_add_reader(sc_context_t *ctx, sc_reader_t *reader)
 {
-	if (reader == NULL || ignored_reader(ctx, reader)) {
+	if (reader == NULL
+	    || ignored_reader(ctx, reader)
+	    || scoped_out_reader(ctx, reader)) {
 		return SC_ERROR_INVALID_ARGUMENTS;
 	}
 	reader->ctx = ctx;
@@ -974,6 +985,22 @@ int sc_context_create(sc_context_t **ctx_out, const sc_context_param_t *parm)
 	ctx->flags = parm->flags;
 	set_defaults(ctx, &opts);
 
+	/* Scoped-reader filter: parameter takes precedence over env var. */
+	{
+		const char *scoped = NULL;
+		if (parm->scoped_reader_name && parm->scoped_reader_name[0] != '\0')
+			scoped = parm->scoped_reader_name;
+		else
+			scoped = getenv("OPENSC_SCOPED_READER");
+		if (scoped && scoped[0] != '\0') {
+			ctx->scoped_reader_name = strdup(scoped);
+			if (ctx->scoped_reader_name == NULL) {
+				sc_release_context(ctx);
+				return SC_ERROR_OUT_OF_MEMORY;
+			}
+		}
+	}
+
 	if (0 != list_init(&ctx->readers)) {
 		del_drvs(&opts);
 		sc_release_context(ctx);
@@ -1129,6 +1156,10 @@ int sc_release_context(sc_context_t *ctx)
 	free(ctx->debug_filename);
 	free(ctx->app_name);
 	free(ctx->exe_path);
+	if (ctx->scoped_reader_name) {
+		free(ctx->scoped_reader_name);
+		ctx->scoped_reader_name = NULL;
+	}
 	list_destroy(&ctx->readers);
 	sc_mem_clear(ctx, sizeof(*ctx));
 	free(ctx);
diff --git a/src/libopensc/internal.h b/src/libopensc/internal.h
index 2a98f0e96..79713c9af 100644
--- a/src/libopensc/internal.h
+++ b/src/libopensc/internal.h
@@ -90,6 +90,13 @@ struct sc_atr_table {
 int _sc_add_reader(struct sc_context *ctx, struct sc_reader *reader);
 int _sc_parse_atr(struct sc_reader *reader);
 
+/**
+ * Returns 1 if @p reader is filtered out by the context's
+ * scoped_reader_name (exact-match whitelist); 0 otherwise.
+ * If ctx->scoped_reader_name is NULL, always returns 0.
+ */
+int scoped_out_reader(struct sc_context *ctx, struct sc_reader *reader);
+
 /* Add an ATR to the card driver's struct sc_atr_table */
 int _sc_add_atr(struct sc_context *ctx, struct sc_card_driver *driver, struct sc_atr_table *src);
 int _sc_free_atr(struct sc_context *ctx, struct sc_card_driver *driver);
diff --git a/src/libopensc/opensc.h b/src/libopensc/opensc.h
index 73c2700c2..04829d4bf 100644
--- a/src/libopensc/opensc.h
+++ b/src/libopensc/opensc.h
@@ -901,6 +901,10 @@ typedef struct sc_context {
 
 	unsigned int magic;
 	int disable_hw_pkcs1_padding;
+
+	/* Per-context exact-match reader whitelist; see
+	 * sc_context_param_t::scoped_reader_name. NULL = no scope (default). */
+	char *scoped_reader_name;
 } sc_context_t;
 
 /* APDU handling functions */
@@ -993,6 +997,14 @@ typedef struct {
 	sc_thread_context_t *thread_ctx;
 	int debug;
 	FILE *debug_file;
+	/**
+	 * If non-NULL, _sc_add_reader() honours only readers whose name
+	 * exactly matches this string. Complementary to the
+	 * opensc.conf-level `ignored_readers` blacklist; this is a
+	 * per-context exact-match whitelist. The environment variable
+	 * OPENSC_SCOPED_READER provides a fallback when this is NULL.
+	 */
+	const char *scoped_reader_name;
 } sc_context_param_t;
 
 /**
-- 
2.54.0

