# Maintainer: hirashix0 <hirashix0@proton.me>
#
# librescrs-middleware — the Qt-free C++23 smart-card core of the LibreSCRS
# stack plus its card plugins and the in-tree PKCS#11 module. This is the
# bottom of the dependency chain:
#
#     librescrs-middleware  <=  librelinux  <=  librekde
#
# SOURCES
# -------
# The project's own source is the signed release tag, cloned with git:
# makepkg verifies the tag's signature against validpgpkeys, the LibreSCRS
# release key in KEYS, and that is what the 'SKIP' checksum of that entry
# stands on. A checksum could not do it: this recipe travels inside the tree
# the checksum would cover, and the tag does not exist until release day.
#
# makepkg's git source carries no submodules, so the two vendored upstream
# trees (thirdparty/opensc-source, thirdparty/curl-source) are fetched as
# archives of their pinned commits and laid into place by prepare(). Those
# commits never move under a tag, so their checksums are real and final.
# packaging/arch/check-recipe.sh arm 3 refuses a pin that is not the gitlink,
# and arm 4 a real archive without a real checksum.

pkgname=librescrs-middleware
pkgver=5.0.0
pkgrel=1
pkgdesc="Qt-free C++23 smart-card middleware, card plugins, and PKCS#11 module for LibreSCRS (eID, ePassports, PIV, PKCS#15)"
arch=('x86_64')
url="https://github.com/LibreSCRS/LibreMiddleware"
license=('LGPL-2.1-or-later' 'Apache-2.0' 'OFL-1.1' 'MIT')   # MIT = vendored curl (curl license)
# Runtime: system libs the LibreSCRS_* shared objects + plugins link against.
# OpenSSL (libcrypto) is BUNDLED statically (thirdparty/openssl-3.5.8) and is
# therefore NOT a runtime depend.
depends=(
    'pcsclite'      # PCSC::PCSC — APDU transport
    # curl is BUNDLED statically (thirdparty/curl-source, built against the
    # bundled OpenSSL) — NOT a runtime depend; only its transitive system zlib
    # remains below.
    'libxml2'       # native AdES signing (XAdES/manifest)
    'zlib'          # RsEId + vendored OpenSC link `z`
    'gcc-libs'
    'glibc'
)
# Build host tooling. The vendored OpenSC is bootstrapped with autotools
# (autoreconf via ./bootstrap) at build time, hence the autotools chain.
makedepends=(
    'cmake'
    'ninja'
    'git'           # GitVersion.cmake derives the version from tags
    'python'        # build-time manifest.json -> constexpr header codegen (REQUIRED)
    'python-jsonschema' # manifest2header.py validates the manifest against its
                    #   schema and HARD-FAILS without this, so the build stops at
                    #   the first generated header. The CI image installs it; this
                    #   recipe did not, and a clean chroot is the only place that
                    #   difference shows
    'autoconf'      # vendored OpenSC ./bootstrap
    'automake'
    'libtool'
    'pkgconf'
)
# No p11-kit registration is installed: build() leaves
# LIBREMIDDLEWARE_INSTALL_P11KIT_MODULE at its default, OFF, because exactly one
# PKCS#11 provider may own a card and on a desktop that is the card agent.
# packaging/arch/README.md names the one command that registers the direct
# module on a machine that deliberately has no agent.
options=('!lto')   # LTO off, as the RPM spec does; not measured to be required
source=(
    "git+https://github.com/LibreSCRS/LibreMiddleware.git#tag=$pkgver?signed"
    # The pinned upstream trees, laid into the submodule paths by prepare().
    # Pins match `git -C thirdparty/<sub> rev-parse HEAD`.
    "opensc-source-$pkgver.tar.gz::https://github.com/OpenSC/OpenSC/archive/07d0d40b0e4051f6fe11f3a92cec56d320670d85.tar.gz"
    "curl-source-$pkgver.tar.gz::https://github.com/curl/curl/archive/01346829096c61b372692f6dc43ffa778c6caccd.tar.gz"
)
# The LibreSCRS release key's primary fingerprint, as published in KEYS.
validpgpkeys=('6B05889AC9A6A7188DF639B06F27A989C2031D16')
sha256sums=(
    'SKIP'
    '395904bf1ebf929825b6c5fe3f3345929675bd2cbb4689a17760a5c14186606c'
    '64cd4fdf196bce8bc381f4ae6f8d0e4e4c4f3b93b73b69deb8d78dab24f2d9ff'
)

prepare() {
    cd "$srcdir/LibreMiddleware"
    # Drop the separately-fetched submodule sources into their paths so the
    # vendored static builds (thirdparty/CMakeLists.txt) find their source trees.
    # The clone leaves each path empty, but a local build may find it
    # populated, so the replacement must be a replacement and not a merge —
    # hence rm -rf, not rmdir. rmdir removes an EMPTY directory and quietly
    # does nothing otherwise, which would leave cp -aT to merge the pinned tree
    # over a populated one: a file upstream deleted would survive in the
    # package with nothing to show it had.
    if [ -d ../OpenSC-07d0d40b0e4051f6fe11f3a92cec56d320670d85 ]; then
        rm -rf thirdparty/opensc-source
        cp -aT ../OpenSC-07d0d40b0e4051f6fe11f3a92cec56d320670d85 thirdparty/opensc-source
    fi
    if [ -d ../curl-01346829096c61b372692f6dc43ffa778c6caccd ]; then
        rm -rf thirdparty/curl-source
        cp -aT ../curl-01346829096c61b372692f6dc43ffa778c6caccd thirdparty/curl-source
    fi
}

build() {
    cd "$srcdir/LibreMiddleware"
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DLIBRESCRS_BUILD_EXAMPLES=OFF \
        -DINSTALL_GTEST=OFF \
        -DBUILD_TESTING=OFF
    cmake --build build -j4
}

check() {
    cd "$srcdir/LibreMiddleware"
    # Card-hardware / live-PIN suites self-skip without a reader + the
    # LIBRESCRS_TEST_* env vars; the rest are pure unit tests. QT_QPA is
    # harmless here (the core is Qt-free) but kept for a uniform check() shape.
    QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure -j4
}

package() {
    cd "$srcdir/LibreMiddleware"
    DESTDIR="$pkgdir" cmake --install build
    # cmake --install already lays down: /usr/lib/libLibreSCRS_*.so,
    # /usr/lib/librescrs/plugins/*.so, /usr/lib/pkcs11/librescrs-pkcs11.so,
    # /usr/include/LibreSCRS/**, /usr/lib/cmake/LibreMiddleware/**,
    # /usr/share/librescrs/certificates/**.
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
