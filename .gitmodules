[submodule "thirdparty/opensc-source"]
	path = thirdparty/opensc-source
	url = https://github.com/OpenSC/OpenSC.git
	# Tracks upstream OpenSC directly: the Serbian eID (srbeid) CardEdge
	# driver, its RSA-2048 raw signing/decryption, and the G&D SCE7 PIV
	# support are all merged upstream, so no downstream patches or fork are
	# needed. `ignore = dirty` keeps outer `git status` clean against the
	# autotools bootstrap artifacts the vendored build writes into the tree.
	ignore = dirty
[submodule "thirdparty/curl-source"]
	path = thirdparty/curl-source
	url = https://github.com/curl/curl.git
